# Copy this file to .env (which is gitignored) and fill in real values.
# compose.yml references these via ${VAR} interpolation -- Compose loads
# .env automatically from the same directory, no extra flag needed.

# InfluxDB credentials. Referenced by both the garmin-fetch-data and
# influxdb services in compose.yml -- a single value here keeps them from
# drifting out of sync with each other.
INFLUXDB_USER=influxdb_user
INFLUXDB_PASSWORD=change_me

# Garmin Connect credentials (optional -- omit both to log in
# interactively on first run instead). Password must still be Base64
# encoded, matching config.py's GARMINCONNECT_BASE64_PASSWORD handling.
GARMINCONNECT_EMAIL=
GARMINCONNECT_BASE64_PASSWORD=

# Grafana admin login.
GRAFANA_ADMIN_PASSWORD=change_me
